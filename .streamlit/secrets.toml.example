# Streamlit Community Cloud: App settings → Secrets. Paste these lines and fill in the key.
# Root-level keys become environment variables, which app/settings.py reads.
# Locally, use .env instead (copy .env.example). Never commit a real secrets.toml.

GROQ_API_KEY = "gsk_..."
APP_ENV = "production"
MIN_SIMILARITY = "0.63"
RATE_LIMIT = "20/minute"
GLOBAL_RATE_LIMIT = "60/minute"
