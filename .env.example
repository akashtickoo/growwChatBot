# Copy to .env and fill in GROQ_API_KEY. Never commit .env.

# --- LLM (Groq) ---
# The app starts without a key; answers that need the LLM return 503.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional second model, tried once after a rate limit or server error. Empty = off.
GROQ_FALLBACK_MODEL=
LLM_REASONING_EFFORT=low
EXTRACTION_REASONING_EFFORT=medium
LLM_MAX_TOKENS=2048
# Advice judge, used by the evaluation only.
JUDGE_MODEL=qwen/qwen3.8-27b

# --- App ---
# development or production
APP_ENV=development
INDEX_DIR=data/index
RETRIEVAL_TOP_K=5
MIN_SIMILARITY=0.45
REQUEST_TIMEOUT_S=20
RATE_LIMIT=20/minute
DISPLAY_TIMEZONE=Asia/Kolkata
STALE_SOURCE_DAYS=14
# Local development only. The app refuses to start with this on when APP_ENV=production.
DEBUG_LOG_QUERIES=false
